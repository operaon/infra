# Logs e saídas de comando geradas sem querer (ex: docker-compose build > build.log)
*.log
build.log

# Logs de runtime do nginx (montados como volume, sempre divergem entre
# ambientes/servidores — nunca devem ser versionados; ver incidente de
# conflito de merge em nginx/logs/*.log no deploy de produção).
nginx/logs/

# Scripts SQL de debug/consulta manual avulsa
docker/check_*.sql

# Certificados SSL (nunca versionar)
docker/certbot_certs/

# Não é mais necessário: credenciais de banco/redis vêm todas de
# velyon_api/.env via env_file. Se esse arquivo for recriado localmente
# por engano, não deve ser versionado.
docker/.env
