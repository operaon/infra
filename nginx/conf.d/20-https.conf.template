# ============================================================
# HTTPS (porta 443) — habilitado automaticamente apenas quando
# /etc/letsencrypt/live/__CERT_NAME__/{fullchain,privkey}.pem
# existem (ver nginx/docker-entrypoint.d/10-enable-ssl.sh).
#
# Este arquivo termina em ".template" de propósito: o Nginx só
# inclui *.conf de conf.d/, então ele é ignorado até o entrypoint
# copiá-lo para 20-https.conf no boot do container.
# ============================================================

# ------------------------------------------------------------
# velyonrobotics.com (+ www) → site estático
# ------------------------------------------------------------
server {
    listen 443 ssl;
    http2 on;
    server_name velyonrobotics.com www.velyonrobotics.com;

    # Resolvido dinamicamente a cada request (ver "resolver" em
    # nginx.conf) em vez de upstream estático — sobrevive a
    # recreate/restart do container "site".
    set $site_upstream site:5174;
    set $api_upstream api:3000;
    set $tenant_upstream frontend:5173;
    set $client_upstream client:5175;
    set $chat_upstream chat:4000;
    set $crm_upstream crm:4100;
    set $pay_upstream pay:4200;
    set $catalog_upstream catalog:4400;
    set $minio_upstream minio:9000;

    ssl_certificate     /etc/letsencrypt/live/__CERT_NAME__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__CERT_NAME__/privkey.pem;
    ssl_trusted_certificate /etc/letsencrypt/live/__CERT_NAME__/fullchain.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;
    ssl_session_tickets off;

    # Otimização SSL (Professional Standard)
    ssl_stapling on;
    ssl_stapling_verify on;
    # SEM 'resolver' aqui de propósito: um resolver declarado dentro do
    # server{} sobrescreve o 'resolver 127.0.0.11 valid=10s;' herdado do
    # http{} (nginx.conf) só para este bloco. Como 127.0.0.11 é o DNS
    # embutido do Docker, ele resolve tanto os nomes internos dos
    # containers (api, frontend, site — usados no proxy_pass via
    # $api_upstream/$frontend_upstream) quanto nomes externos (ex.: o
    # responder OCSP do stapling), pois repassa consultas desconhecidas
    # pro DNS do host. Usar 8.8.8.8/1.1.1.1 aqui quebrava a resolução dos
    # upstreams internos → 502 Bad Gateway.
    ssl_dhparam /etc/letsencrypt/dhparam.pem;

    include /etc/nginx/snippets/security-headers.conf;

    access_log /var/log/nginx/access.log main;
    error_log  /var/log/nginx/error.log warn;

    include /etc/nginx/snippets/site-locations.conf;
}

