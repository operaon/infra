# ==================== STAGE 1: BUILDER ====================
FROM node:20-alpine AS builder

WORKDIR /app

COPY package*.json ./
COPY pnpm-lock.yam[l] ./

RUN npm install -g pnpm && \
    pnpm install --no-frozen-lockfile && \
    npm cache clean --force

COPY client ./client
COPY server ./server
COPY shared ./shared
COPY drizzle ./drizzle
COPY tsconfig.json vite.config.ts ./

ARG VITE_API_BASE_URL
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}

RUN pnpm run build

# ==================== STAGE 2: RUNTIME ====================
FROM node:20-alpine

LABEL org.opencontainers.image.title="Operaon Frontend Client"
LABEL org.opencontainers.image.description="Operaon frontend client (production)"
LABEL org.opencontainers.image.source="https://github.com/operaon/frontend_client"
LABEL org.opencontainers.image.version="1.0.0"

WORKDIR /app

RUN apk add --no-cache dumb-init curl

RUN addgroup -g 1001 -S nodejs && \
    adduser -S nodejs -u 1001

RUN mkdir -p /app/logs /app/tmp && \
    chown -R nodejs:nodejs /app

COPY --from=builder --chown=nodejs:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=nodejs:nodejs /app/server ./server
COPY --from=builder --chown=nodejs:nodejs /app/tsconfig.json ./
COPY --from=builder --chown=nodejs:nodejs /app/dist ./dist
COPY --chown=nodejs:nodejs package*.json ./

RUN npm install -g pnpm && npm cache clean --force

USER nodejs

EXPOSE 5175

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:5175/health || exit 1

ENTRYPOINT ["dumb-init", "--"]
CMD ["pnpm", "run", "start"]
