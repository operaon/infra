# ─────────────────────────────────────────────────────────────────
# velyon_billing — Production Dockerfile
# Multi-stage build, non-root user, dumb-init, healthcheck
# ─────────────────────────────────────────────────────────────────

# ── Stage 1: Build ──────────────────────────────────────────────
FROM node:22-alpine AS builder

WORKDIR /app

# Install dumb-init
RUN apk add --no-cache dumb-init

# Copy manifests
COPY package.json package-lock.json* ./

# Install dependencies (production only)
RUN npm ci --only=production --ignore-scripts

# Copy source
COPY src/ ./src/

# ── Stage 2: Runtime ────────────────────────────────────────────
FROM node:22-alpine

WORKDIR /app

# Install Chromium for PDF generation + dumb-init
RUN apk add --no-cache dumb-init chromium && \
    addgroup -S appgroup && \
    adduser -S appuser -G appgroup && \
    chown -R appuser:appgroup /app

# Copy built artifacts from builder
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/src ./src
COPY --from=builder /app/package.json ./package.json
COPY --from=builder /usr/bin/dumb-init /usr/bin/dumb-init

# Set environment
ENV NODE_ENV=production
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser

# Expose port
EXPOSE 4600

# Healthcheck
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:4600/api/health || exit 1

# Create volumes for logs and temp files
VOLUME ["/app/logs", "/app/tmp"]

# Run as non-root with dumb-init for proper signal handling
ENTRYPOINT ["dumb-init", "--"]
USER appuser

CMD ["node", "src/server.js"]
