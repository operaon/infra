# Infraestrutura Operaon — copie para docker/.env apenas no ambiente local.
# Nunca versione docker/.env. Em produção, prefira um secret manager.

# Certificados Let's Encrypt — substitua pelos domínios reais do ambiente.
LETSENCRYPT_EMAIL=ops@example.com
DOMAIN=velyonrobotics.com
CERT_NAME=velyonrobotics.com
DOMAINS=velyonrobotics.com,www.velyonrobotics.com,api.velyonrobotics.com,chat.velyonrobotics.com,crm.velyonrobotics.com,pay.velyonrobotics.com,agend.velyonrobotics.com,catalog.velyonrobotics.com,faturament.velyonrobotics.com

# MinIO/S3 interno — use credenciais longas e aleatórias no runtime
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=replace-with-runtime-root-user
MINIO_ROOT_PASSWORD=replace-with-runtime-root-password
# Compatibilidade dos clientes SDK; use os mesmos valores acima quando necessário.
MINIO_ACCESS_KEY=replace-with-runtime-root-user
MINIO_SECRET_KEY=replace-with-runtime-root-password
MINIO_BUCKET=operaon-media

# Identificador público não secreto usado no build do frontend
VITE_CLARITY_PROJECT_ID=
