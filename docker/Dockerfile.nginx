# ==================== STAGE 1: BUILDER ====================
FROM nginx:alpine AS builder

RUN rm -f /etc/nginx/conf.d/default.conf

# ==================== STAGE 2: RUNTIME ====================
FROM nginx:alpine

LABEL org.opencontainers.image.title="Operaon Nginx Reverse Proxy"
LABEL org.opencontainers.image.description="Operaon reverse proxy for API, frontends and modular services"
LABEL org.opencontainers.image.source="https://github.com/operaon/infra"
LABEL org.opencontainers.image.version="1.0.0"

COPY nginx/nginx.conf   /etc/nginx/nginx.conf
COPY nginx/conf.d       /etc/nginx/conf.d
COPY nginx/snippets     /etc/nginx/snippets
COPY nginx/docker-entrypoint.d/10-enable-ssl.sh /docker-entrypoint.d/10-enable-ssl.sh

# Os certificados NÃO são copiados para dentro da imagem.
# Eles chegam em tempo de execução via volume certbot_certs
# montado em /etc/letsencrypt no docker-compose. O script
# /docker-entrypoint.d/10-enable-ssl.sh (rodado automaticamente pela
# imagem oficial do nginx no boot) decide se habilita HTTPS (porta 443)
# com base na presença desses certificados — mesma imagem funciona em
# produção (com certificado) e localmente (sem certificado, só HTTP).

RUN sed -i 's/\r$//' /docker-entrypoint.d/10-enable-ssl.sh && \
    chmod +x /docker-entrypoint.d/10-enable-ssl.sh && \
    mkdir -p /var/www/certbot /var/log/nginx && \
    rm -f /etc/nginx/conf.d/default.conf

EXPOSE 80 443

HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://localhost/nginx-health || exit 1