# ==================== STAGE 1: BUILDER ====================
FROM nginx:alpine AS builder

RUN rm -f /etc/nginx/conf.d/default.conf

# ==================== STAGE 2: RUNTIME ====================
FROM nginx:alpine

LABEL maintainer="seu-email@exemplo.com"
LABEL version="1.0.0"
LABEL description="Velyon - Nginx Reverse Proxy (API + Frontend)"
LABEL org.opencontainers.image.source="https://github.com/seu-usuario/velyon"

COPY nginx/nginx.conf /etc/nginx/nginx.conf
COPY nginx/conf.d /etc/nginx/conf.d
COPY nginx/ssl/cert.pem /etc/nginx/ssl/cert.pem
COPY nginx/ssl/key.pem  /etc/nginx/ssl/key.pem

RUN mkdir -p /etc/nginx/ssl /var/www/certbot && \
    rm -f /etc/nginx/conf.d/default.conf

EXPOSE 80 443

HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://localhost/nginx-health || exit 1